PORT=3001
NODE_ENV=development

# Database Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fund_tracker
# Or individual PG params:
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=fund_tracker
# PGUSER=postgres
# PGPASSWORD=postgres

# Allowed Client Origins for CORS (comma separated)
CLIENT_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006

# JWT Configuration
JWT_ACCESS_SECRET=dev_jwt_access_secret_change_me_in_production
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_change_me_in_production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Google OAuth (Required for Google login, optional for Explore Demo Mode)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
