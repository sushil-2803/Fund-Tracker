# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env:  cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/fund_tracker

# ── Google OAuth ──────────────────────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com/
# 2. Create a project → APIs & Services → Credentials → Create OAuth 2.0 Client ID
# 3. Application type: Web application
# 4. Authorised JavaScript origins: http://localhost:3000 (and your prod domain)
# 5. Authorised redirect URIs: not needed (we use the token-based flow)
# 6. Copy the Client ID below
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ── JWT (for session tokens issued after Google login) ───────────────────────
# Generate:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_random_hex_chars_access
JWT_REFRESH_SECRET=replace_with_64_random_hex_chars_refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3001
CLIENT_ORIGIN=http://localhost:3000
NODE_ENV=development
