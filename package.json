{
  "name": "fund-tracker",
  "version": "1.0.0",
  "description": "Fund Allocation Expense Tracker — full-stack monorepo",
  "private": true,
  "scripts": {
    "install:all":  "npm install --prefix backend && npm install --prefix frontend && npm install --prefix mobile",
    "dev":          "concurrently -n API,UI -c cyan,magenta \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend":  "npm run dev   --prefix backend",
    "dev:frontend": "npm run dev   --prefix frontend",
    "mobile":       "npm start     --prefix mobile",
    "mobile:android": "npm run android --prefix mobile",
    "mobile:ios":     "npm run ios     --prefix mobile",
    "mobile:build":   "npm run build:apk --prefix mobile",
    "mobile:install": "npm run install:apk --prefix mobile",
    "mobile:device":  "npm run dev:device  --prefix mobile",
    "adb:reverse":    "npm run adb:reverse --prefix mobile",
    "start":        "npm start     --prefix backend",
    "build":        "npm run build --prefix frontend",
    "migrate":      "node backend/migrate.js",
    "seed":         "node backend/seed.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
