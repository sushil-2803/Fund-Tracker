# Copy to .env.local (Vite loads this automatically and keeps it out of git)
# cp .env.example .env.local

# Your Google OAuth Client ID (same one as backend)
# Find it at: https://console.cloud.google.com → APIs & Services → Credentials
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Browser-facing URLs used by Vite at build time.
VITE_FRONTEND_URL=https://fundflow.sushildubey.cloud
VITE_API_BASE_URL=https://fundflowapi.sushildubey.cloud/api
VITE_LOCAL_API_BASE_URL=http://192.168.1.57:3009/api
