# ==============================================================================
# FundTracker Mobile — Public Environment Variables
# ==============================================================================
# NOTE: Only variables prefixed with EXPO_PUBLIC_ are bundled into client code.
# NEVER put private server secrets, database URLs, JWT signing secrets,
# or private API keys in this file or any EXPO_PUBLIC_* variable.
#
# In production, EXPO_PUBLIC_API_BASE_URL MUST use HTTPS (https://...).
# ==============================================================================

# Backend API Base URL
# Development (Physical Android device over USB with `npm run adb:reverse`):
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001

# Development (Android Emulator default mapping):
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3001

# Development (LAN Wi-Fi testing — replace with your computer's local IP):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.57:3001

# Production (Must use HTTPS):
# EXPO_PUBLIC_API_BASE_URL=https://api.fundtracker.app

# ------------------------------------------------------------------------------
# Google OAuth Client IDs (Obtain from Google Cloud Console / Firebase Auth)
# ------------------------------------------------------------------------------
# Web Client ID (Required for Google native sign-in token verification):
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=REPLACE_WITH_WEB_CLIENT_ID.apps.googleusercontent.com

# iOS Client ID (Optional / Platform specific):
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=REPLACE_WITH_IOS_CLIENT_ID.apps.googleusercontent.com

# Android Client ID (Optional / Platform specific):
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=REPLACE_WITH_ANDROID_CLIENT_ID.apps.googleusercontent.com
