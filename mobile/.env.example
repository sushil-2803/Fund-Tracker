# ─────────────────────────────────────────────────────────────────────────────
# FundTracker Mobile — Environment Variables Example
# Copy this file to .env:  copy .env.example .env
# ─────────────────────────────────────────────────────────────────────────────
#
# IMPORTANT: Expo only exposes variables prefixed with EXPO_PUBLIC_ to the app.
# Never put secrets (private keys, passwords) here — they are bundled into the APK.
#
# ─────────────────────────────────────────────────────────────────────────────

# ── Google OAuth — Web Client ID ──────────────────────────────────────────────
#
# HOW TO GET:
#   1. Go to https://console.cloud.google.com/
#   2. Select your project (or create one)
#   3. Navigate to: APIs & Services → Credentials
#   4. Click "Create Credentials" → "OAuth 2.0 Client ID"
#   5. Application type: Web application
#   6. Name: "FundTracker Web" (or anything)
#   7. Authorised JavaScript origins: http://localhost:3000 (and your prod domain)
#   8. Click Create → COPY the "Client ID" (ends with .apps.googleusercontent.com)
#
# NOTE: This is the WEB client ID — used by the mobile app to verify tokens.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com

# ── Google OAuth — Android Client ID ─────────────────────────────────────────
#
# HOW TO GET:
#   1. Same Credentials page in Google Cloud Console
#   2. Click "Create Credentials" → "OAuth 2.0 Client ID"
#   3. Application type: Android
#   4. Package name: com.fundtracker.mobile
#   5. SHA-1 certificate fingerprint: (see SHA-1 GENERATION section below)
#   6. Click Create → COPY the "Client ID"
#
# ── SHA-1 CERTIFICATE FINGERPRINT (Required for Android OAuth) ────────────────
#
# For DEBUG builds (development):
#   Run this command in your terminal:
#
#   Windows (PowerShell):
#     keytool -list -v -keystore "$env:USERPROFILE\.android\debug.keystore" `
#       -alias androiddebugkey -storepass android -keypass android
#
#   Mac/Linux:
#     keytool -list -v -keystore ~/.android/debug.keystore \
#       -alias androiddebugkey -storepass android -keypass android
#
#   Look for the line:   SHA1: XX:XX:XX:XX:XX:...
#   Your debug SHA-1:    BE:74:13:F7:8A:8D:01:42:DC:18:31:16:6D:3D:9B:67:83:11:72:23
#
# For RELEASE builds (production):
#   Use your release keystore:
#     keytool -list -v -keystore your-release-key.jks -alias your-alias
#
# ─────────────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_android_client_id.apps.googleusercontent.com

# ── Backend API Base URL ──────────────────────────────────────────────────────
#
# Choose the correct URL for your environment:
#
#   Android Emulator:     http://10.0.2.2:3001
#   Physical Device:      http://192.168.1.X:3001  (replace with your PC's LAN IP)
#   Production:           https://fundflowapi.sushildubey.cloud
#
# Find your local IP:
#   Windows:   ipconfig   → look for "IPv4 Address" under your WiFi adapter
#   Mac/Linux: ifconfig   → look for "inet" under en0/wlan0
#
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3001

# ── App Environment ───────────────────────────────────────────────────────────
EXPO_PUBLIC_ENV=development
